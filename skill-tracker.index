<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>技术岗位能力自查表</title><style>
*{box-sizing:border-box}body{background:#f4f6fa;color:#263447;font:15px/1.6 -apple-system,BlinkMacSystemFont,sans-serif;margin:0}main{max-width:760px;margin:auto;padding:18px 12px}section,header,footer{background:white;border:1px solid #e1e5ec;border-radius:16px;padding:16px;margin:14px 0}h1{font-size:25px;margin:0}h2{font-size:18px;margin:0}small,p{color:#657185}.big{font-size:40px;color:#315f92;font-weight:bold}progress{width:100%;accent-color:#4277ad;height:12px}.item{border-top:1px solid #eee;padding:12px 0}.dots{display:flex;align-items:center;gap:2px;margin-top:6px}.dot{border:0;background:none;padding:2px;width:27px;height:30px;cursor:pointer;touch-action:manipulation}.dot:before{content:'';display:block;width:20px;height:20px;border:1px solid #aab9ca;border-radius:50%}.dot.on:before{background:#4277ad;border-color:#4277ad}.score{margin-left:auto;font-size:12px}.pct{float:right;color:#315f92}button.action{padding:8px;border:1px solid #bbc8d8;background:white;border-radius:8px;color:#315f92;margin:4px;font:inherit}@media(max-width:360px){.dot{width:23px}.dot:before{width:17px;height:17px}.dots{gap:0}}
</style><main><h1>技术岗位能力自查表</h1><p>金融工程 · 长期学习计划</p><header><small>总体掌握进度</small><div class="big" id="total"></div><progress id="overall" max="300"></progress><p id="count"></p><small>点击第 N 个圆圈设置 N/10；再次点击当前圆圈回退一级。0 未开始，3 理解基础，5 能参考资料实现，8 能独立应用，10 能独立实现、解释及排错。</small></header><div id="groups"></div><footer><button class="action" id="exp">导出备份</button><button class="action" id="imp">恢复进度</button><button class="action" id="reset">清空进度</button><input hidden type="file" id="file" accept=".json"><p id="msg"></p><small>进度保存在当前浏览器（需支持本地存储）。更换设备或移动文件前请导出备份。</small></footer></main><script>const groups=[["程序设计与算法", ["独立完成基础循环、函数、递归题目", "理解指针、内存、变量作用域", "掌握链表、栈、队列、哈希表、树", "独立实现常见排序和搜索算法", "能够分析时间与空间复杂度", "能够独立调试陌生代码"]], ["Python与工程工具", ["熟练使用Python基础语法与面向对象编程", "熟练使用NumPy、pandas、SciPy", "能处理缺失值、异常值及大规模数据", "掌握SQL查询、连接、聚合与窗口函数", "能够使用Linux终端、SSH和环境管理", "使用Git管理项目、编写测试和文档"]], ["数学与统计", ["掌握微积分、多元微积分与线性代数", "熟练解决条件概率、条件期望等问题", "理解参数估计、MLE、假设检验", "能够推导并解释OLS及其假设", "掌握马尔可夫链、泊松过程、布朗运动", "理解伊藤引理、蒙特卡洛与数值优化"]], ["金融专业能力", ["理解债券定价、收益率曲线与期限结构", "能够计算久期、凸性、DV01和KRD", "理解远期、期货、互换与期权", "理解无套利定价、风险中性定价和BS模型", "掌握时间序列分析与模型验证", "独立完成定价、风险分析或策略研究"]], ["项目与面试能力", ["不依赖AI独立实现项目核心逻辑", "能够解释简历中每一个模型和算法", "能够解释模型选择、假设和局限性", "能够处理面试官临时修改的任务条件", "拥有至少两个可复现的完整技术项目", "能够使用英语解释自己的技术工作"]]];const $=id=>document.getElementById(id),key='finance-skills-v1';let scores=Array(30).fill(0);const valid=x=>Array.isArray(x)&&x.length===30&&x.every(n=>Number.isInteger(n)&&n>=0&&n<=10);try{let x=JSON.parse(localStorage.getItem(key));if(valid(x))scores=x}catch(e){}function save(){try{localStorage.setItem(key,JSON.stringify(scores));$('msg').textContent='进度已保存'}catch(e){$('msg').textContent='无法自动保存，请导出备份'}}groups.forEach(([name,items],g)=>{let s=document.createElement('section');s.innerHTML=`<h2>${g+1}. ${name}<span class="pct" id="pct${g}"></span></h2><progress max="60" id="p${g}"></progress>`;items.forEach((name,j)=>{let i=g*6+j,r=document.createElement('div');r.className='item';r.innerHTML=`<div>${i+1}. ${name}</div><div class="dots" id="d${i}"></div>`;let d=r.lastElementChild;for(let n=1;n<=10;n++){let b=document.createElement('button');b.className='dot';b.setAttribute('aria-label',name+' '+n+'/10');b.onclick=()=>{scores[i]=scores[i]===n?n-1:n;update();save()};d.append(b)}let t=document.createElement('span');t.className='score';t.id='s'+i;d.append(t);s.append(r)});$('groups').append(s)});function update(){scores.forEach((v,i)=>{Array.from($('d'+i).querySelectorAll('button')).forEach((b,j)=>{b.classList.toggle('on',j<v);b.setAttribute('aria-pressed',String(j<v))});$('s'+i).textContent=v+'/10'});for(let g=0;g<5;g++){let n=scores.slice(g*6,g*6+6).reduce((a,b)=>a+b,0);$('p'+g).value=n;$('pct'+g).textContent=Math.round(n/60*100)+'%'}let n=scores.reduce((a,b)=>a+b,0);$('overall').value=n;$('total').textContent=Math.round(n/3)+'%';$('count').textContent='累计 '+n+'/300 分 · 完全掌握 '+scores.filter(x=>x===10).length+'/30 项'}$('exp').onclick=()=>{let a=document.createElement('a'),u=URL.createObjectURL(new Blob([JSON.stringify({scores},null,2)],{type:'application/json'}));a.href=u;a.download='skill-progress.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1000)};$('imp').onclick=()=>$('file').click();$('file').onchange=async e=>{try{let x=JSON.parse(await e.target.files[0].text());if(!valid(x.scores))throw Error();scores=x.scores;update();save()}catch(e){$('msg').textContent='备份文件无效'}$('file').value=''};$('reset').onclick=()=>{if(confirm('确定清空全部进度？')){scores.fill(0);update();save()}};update();</script></html>